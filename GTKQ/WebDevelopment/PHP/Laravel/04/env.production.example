# Template for the .env used by docker-compose.prod.yml ON THE SERVER.
#
#   scp this file to the server, rename it to .env, fill in the real values:
#       sudo chown root:root .env && sudo chmod 600 .env
#
# Every <ANGLE_BRACKET> value below is a credential you must supply yourself.
# None of them are in this repository, and none of them should ever be
# committed, pasted into a Dockerfile, or baked into an image — an image layer
# is readable by anyone who can pull the image.

# ---------------------------------------------------------------------------
# Which image to run
# ---------------------------------------------------------------------------
# The registry path. Requires `docker login` on the server first (see README).
#   GitHub Container Registry:  ghcr.io/<YOUR_GITHUB_USERNAME>/myapp
#   Docker Hub:                 docker.io/<YOUR_DOCKERHUB_USERNAME>/myapp
REGISTRY_IMAGE=ghcr.io/<YOUR_GITHUB_USERNAME>/myapp

# The version to run. Use an explicit, immutable tag — a git SHA or a release
# number. Never "latest": it makes the running version unknowable and rollback
# impossible, because you cannot name the thing you want to go back to.
IMAGE_TAG=1.0.0

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=MyApp
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com

# Generate ONCE with `php artisan key:generate --show` and keep it safe.
# Losing it makes every encrypted column and signed cookie unreadable.
# Changing it logs out every user.
APP_KEY=<PASTE_GENERATED_APP_KEY_HERE>

# ---------------------------------------------------------------------------
# Database — credentials from your managed database provider's console
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=<YOUR_DB_HOST>              # e.g. myapp-db.abc123.eu-west-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=myapp
DB_USERNAME=<YOUR_DB_USERNAME>
DB_PASSWORD=<YOUR_DB_PASSWORD>

# Managed providers usually require TLS. Their console provides the CA file;
# mount it into the container and point this at it.
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-ca.pem

# ---------------------------------------------------------------------------
# Redis — the compose service name, on the internal network
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# These three MUST NOT be "file" in a container. The container filesystem is
# destroyed on every deploy, so file-based sessions would log out every user,
# and a file cache would be empty after each release. With more than one app
# replica it is worse: each container would have its own separate copy.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ---------------------------------------------------------------------------
# Filesystem — uploads must leave the container
# ---------------------------------------------------------------------------
# The local disk is ephemeral. Anything a user uploads to it disappears at the
# next deploy. S3 (or any S3-compatible service: R2, Spaces, MinIO) is the
# default answer.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=<YOUR_BUCKET_NAME>
AWS_URL=

# ---------------------------------------------------------------------------
# Logging — a stream, not a file
# ---------------------------------------------------------------------------
# "stderr" so output goes to `docker compose logs` and on to whatever collects
# it. The default "stack" channel writes to storage/logs/laravel.log, which in
# a container grows unbounded and then vanishes on restart — the log you most
# want to read is the one destroyed by the crash you are investigating.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Mail — credentials from your mail provider (Postmark, SES, Mailgun...)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<YOUR_SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<YOUR_SMTP_USERNAME>
MAIL_PASSWORD=<YOUR_SMTP_PASSWORD>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Error tracking (optional but strongly recommended)
# ---------------------------------------------------------------------------
# With APP_DEBUG=false the user sees a generic 500 page, which is correct —
# but it means you find out about errors only if something is collecting them.
# SENTRY_LARAVEL_DSN=<YOUR_SENTRY_DSN>
